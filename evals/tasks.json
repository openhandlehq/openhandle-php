[
    {
        "id": "01-profile-get",
        "prompt": "Write a function returning the named InstagramProfile model that gets username northstar_forge_test with 24-hour freshness.",
        "required": [
            "use OpenHandle\\",
            "InstagramProfile",
            "->instagram->profile(",
            "->get(",
            "freshness: '24h'"
        ]
    },
    {
        "id": "02-explicit-references",
        "prompt": "Select a TikTok profile by opaque platform ID and an Instagram post by URL, then fetch both resources.",
        "required": [
            "use OpenHandle\\",
            "->tiktok->profile(id: ",
            "->instagram->post(url: ",
            "->get("
        ]
    },
    {
        "id": "03-pagination",
        "prompt": "Collect post IDs from every page of an Instagram profile's posts without constructing cursors manually. Use the named page type in the implementation.",
        "required": [
            "use OpenHandle\\",
            "Page<InstagramPost>",
            "->posts->list(",
            "->data",
            "->next()"
        ]
    },
    {
        "id": "04-nested-replies",
        "prompt": "List replies for a known Instagram post ID and comment ID using the nested resource graph.",
        "required": [
            "use OpenHandle\\",
            "->instagram->post(",
            "->comment(",
            "->replies->list("
        ]
    },
    {
        "id": "05-search",
        "prompt": "Search TikTok posts for synthetic with 24-hour freshness and return the named TikTokPost models.",
        "required": [
            "use OpenHandle\\",
            "TikTokPost",
            "->tiktok->search->posts->list(",
            "q: 'synthetic'",
            "freshness: '24h'"
        ]
    },
    {
        "id": "06-url-fetch",
        "prompt": "Fetch the resource represented by an Instagram post URL when the caller does not know its resource type.",
        "required": [
            "use OpenHandle\\",
            "->fetch(",
            "https://www.instagram.com/p/"
        ]
    },
    {
        "id": "07-errors",
        "prompt": "Handle an SDK failure by returning its code, request ID, and retryable flag. Do not branch on the message.",
        "required": [
            "use OpenHandle\\",
            "OpenHandleError",
            "->code",
            "->requestId",
            "->retryable"
        ],
        "forbidden": [
            "->message ==",
            "->message !=",
            "getMessage() ==",
            "getMessage() !=",
            "str_contains($error->message",
            "str_contains($error->getMessage()"
        ]
    },
    {
        "id": "08-request-controls",
        "prompt": "Get a Twitter profile with retries disabled and a five-second timeout for this one request.",
        "required": [
            "use OpenHandle\\",
            "->twitter->profile(",
            "maxRetries: 0",
            "timeout: 5"
        ]
    },
    {
        "id": "09-billing-metadata",
        "prompt": "Get an Instagram profile using the named response type and return its authoritative cost, environment, and request ID metadata.",
        "required": [
            "use OpenHandle\\",
            "Response<InstagramProfile>",
            "->billing->cost",
            "->billing->environment",
            "->requestId"
        ]
    },
    {
        "id": "10-key-selects-environment",
        "prompt": "Create a reusable client from a caller-provided Test or Live API key without adding a separate environment option.",
        "required": [
            "use OpenHandle\\",
            "new OpenHandle(apiKey: "
        ],
        "forbidden": [
            "environment:",
            "testMode:",
            "liveMode:"
        ]
    }
]
